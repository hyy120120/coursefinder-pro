rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ──── HELPERS ────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    function isAgencyOwner(agencyId) {
      return isAuth() && 
             exists(/databases/(default)/documents/agencies/$(agencyId)) &&
             get(/databases/(default)/documents/agencies/$(agencyId)).data.ownerId == request.auth.uid;
    }
    
    function isAgencyMember(agencyId) {
      return isAuth() && 
             exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId == agencyId;
    }
    
    // ──── USERS ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isAuth() && request.auth.uid == uid && 
                       request.resource.data.uid == uid &&
                       request.resource.data.role in ['agent', 'counsellor'];
      allow update: if isOwner(uid);
      allow delete: if false;
    }
    
    // ──── AGENCIES ────────────────────────────────────────────────────
    match /agencies/{agencyId} {
      allow read: if isAuth() && isAgencyMember(agencyId);
      allow create: if isAuth() && 
                       request.resource.data.ownerId == request.auth.uid &&
                       request.resource.data.name is string &&
                       request.resource.data.tier in ['free', 'pro', 'enterprise'];
      allow update: if isAgencyOwner(agencyId);
      allow delete: if false;
    }
    
    // ──── STUDENTS ────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isAuth() && 
                     exists(/databases/(default)/documents/students/$(studentId)) &&
                     get(/databases/(default)/documents/students/$(studentId)).data.agencyId == 
                     get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow create: if isAuth() && 
                       request.resource.data.agencyId == 
                       get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow update: if isAuth() && 
                       exists(/databases/(default)/documents/students/$(studentId)) &&
                       get(/databases/(default)/documents/students/$(studentId)).data.agencyId == 
                       get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow delete: if isAuth() && 
                       exists(/databases/(default)/documents/students/$(studentId)) &&
                       get(/databases/(default)/documents/students/$(studentId)).data.agencyId == 
                       get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
    }
    
    // ──── APPLICATIONS ────────────────────────────────────────────────────
    match /applications/{applicationId} {
      allow read: if isAuth() && 
                     exists(/databases/(default)/documents/applications/$(applicationId)) &&
                     get(/databases/(default)/documents/applications/$(applicationId)).data.agencyId == 
                     get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow create: if isAuth() && 
                       request.resource.data.agencyId == 
                       get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow update: if isAuth() && 
                       exists(/databases/(default)/documents/applications/$(applicationId)) &&
                       get(/databases/(default)/documents/applications/$(applicationId)).data.agencyId == 
                       get(/databases/(default)/documents/users/$(request.auth.uid)).data.agencyId;
      allow delete: if false;
    }
    
    // ──── COURSES ────────────────────────────────────────────────────
    match /courses/{courseId} {
      allow read: if isAuth();
      allow write: if false;
    }
    
    // ──── NOTIFICATIONS ────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuth() && 
                     request.auth.uid == resource.data.userId;
      allow write: if false;
    }
    
    // ──── CATCH ALL (DENY) ────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
